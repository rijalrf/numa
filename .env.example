# ==============================================================================
# Numa - Environment Variables (.env.example)
# Salin file ini menjadi .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Server API & Frontend
# ------------------------------------------------------------------------------
PORT=6655
NODE_ENV=development
# Origin frontend yang diizinkan (dipisah koma)
FE_URL=http://localhost:3455,https://numa.opendv.xyz
# URL API untuk build frontend web (Vite)
VITE_API_URL=http://localhost:6655

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL
# ------------------------------------------------------------------------------
# URL koneksi langsung (dev lokal / Prisma)
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@localhost:5432/project_ai_planner?schema=public

# Konfigurasi container DB (digunakan jika deploy via Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=project_ai_planner

# ------------------------------------------------------------------------------
# 3. Autentikasi (Better Auth & OAuth)
# ------------------------------------------------------------------------------
# Secret enkripsi Better Auth (di produksi gunakan: openssl rand -hex 32)
BETTER_AUTH_SECRET=numa-dev-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:6655
ENABLE_EMAIL_AUTH=true

# Google OAuth (isi dari Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. AI Provider (OpenAI Compatible Gateway)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=sk-local-dev-key
OPENAI_MODEL=ai-builder
OPENAI_MODEL_REASONING=ai-builder
OPENAI_MODEL_CHEAP=ai-builder
# Opsional: reasoning_effort (low|medium|high) per tier. Kosong = parameter tidak dikirim.
# Catatan: gateway lokal saat ini mengabaikannya; pantau AiCallLog.reasoningTokens.
# OPENAI_REASONING_EFFORT_CHEAP=low
# OPENAI_REASONING_EFFORT_REASONING=

# ------------------------------------------------------------------------------
# 5. Docker Hub (Khusus deployment VPS / CI)
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME=

# Host tambahan yang diizinkan dev server Vite (dipisah koma), mis. domain tunnel
VITE_ALLOWED_HOSTS=

# Antrean job AI: jumlah job yang diproses paralel per instance API (default 4).
AI_JOB_CONCURRENCY=4

# Batas job AI aktif (queued + running) per user sebelum API membalas 429 (default 5).
AI_MAX_ACTIVE_JOBS_PER_USER=5

# Budget token AI bulanan per pemilik tagihan. Kosongkan untuk default (free 300000, starter 3000000, pro 10000000). 0 = tanpa batas.
AI_TOKEN_BUDGET_FREE=
AI_TOKEN_BUDGET_STARTER=
AI_TOKEN_BUDGET_PRO=

# Harga AI untuk estimasi biaya di dashboard admin, dalam rupiah per 1 juta token. Kosong = dashboard menampilkan "Harga belum diatur".
AI_PRICE_INPUT_PER_MTOK_REASONING=
AI_PRICE_OUTPUT_PER_MTOK_REASONING=
AI_PRICE_INPUT_PER_MTOK_CHEAP=
AI_PRICE_OUTPUT_PER_MTOK_CHEAP=

# Email admin platform (pisahkan koma) yang boleh membuka dashboard /admin/usage.
PLATFORM_ADMIN_EMAILS=

# Pembayaran Mayar.id (API V2). Kosong = pembayaran dinonaktifkan (checkout dan webhook menjawab 503).
# API key bertipe Read & Write dari https://web.mayar.io/api-keys (sandbox) atau https://web.mayar.id/api-keys (produksi).
# MAYAR_WEBHOOK_TOKEN dicocokkan dengan header X-Callback-Token. Webhook didaftarkan di dashboard Mayar ke <domain>/api/billing/webhook.
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
# true = api.mayar.id (produksi), selain itu api.mayar.io (sandbox). Key harus sesuai mode.
MAYAR_IS_PRODUCTION=false

# Jumlah hop proxy tepercaya di depan API. 1 = tunnel Cloudflare langsung ke API; 2 = lewat nginx web.
TRUST_PROXY_HOPS=1

# SSO OIDC (opsional). Aktif bila ketiganya terisi. Redirect URI di IdP: <BETTER_AUTH_URL>/api/auth/oauth2/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Scope yang diminta (default: openid email profile).
OIDC_SCOPES=
# true bila IdP memverifikasi email, sehingga akun boleh ditautkan otomatis ke akun yang sudah ada.
OIDC_TRUST_EMAIL=false

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=json|text (default json di produksi).
LOG_LEVEL=info
LOG_FORMAT=
