{
  "name": "numa-cli",
  "version": "0.6.0",
  "description": "CLI agent loop untuk AI coding agent - autonomous task execution via bounded context isolation",
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "autonomous",
    "task-execution"
  ],
  "homepage": "https://github.com/rijalrf/numa#readme",
  "bugs": {
    "url": "https://github.com/rijalrf/numa/issues",
    "email": "support@numa.dev"
  },
  "license": "MIT",
  "author": "Rijal RF <support@numa.dev>",
  "type": "module",
  "bin": {
    "numa": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "publish:latest": "npm run build && npm publish --access public",
    "publish:beta": "npm run build && npm publish --tag beta --access public",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rijalrf/numa.git"
  }
}
