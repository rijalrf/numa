// Prisma schema untuk numa (AI Planner versi refactor).
// Tabel Better Auth + domain aplikasi. Fresh migrate — data lama di-drop.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Better Auth — tabel wajib sesuai Prisma adapter
// ============================================================

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  emailVerified  Boolean    @default(false)
  image          String?
  codingExperience      String?
  referralSource        String?
  referralDetail        String?
  onboardingCompletedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  projects       Project[]
  agentTokens    AgentToken[]
  chatSessions   ChatSession[]
  subscription   Subscription?
  payments       Payment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String   @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  password              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Domain — port dari supabase/migrations/*, rename PRD -> Brd
// ============================================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  idea        String   // ide mentah dari onboarding
  description String?
  status      String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  reviewFlow  Boolean  @default(false)   // bila true, complete -> REVIEW dulu
  wizardStep  String   @default("done")  // chat | techstack | prd | tree | board | guide | done
  uiSpec      Json?                      // spesifikasi desain UI/UX terstruktur (Bab 14)
  repoSummary Json?                      // ringkasan workspace dari numa sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stacks           Stack[]
  questions        DiscoveryQuestion[]
  prd              Prd?
  roadmap          RoadmapPhase[]
  tasks            Task[]
  cycles           ProjectCycle[]
  agentTokenScopes AgentTokenScope[]
  checkpoints      Checkpoint[]
  chatSession      ChatSession?
  treeNodes        TreeNode[]
  aiCallLogs       AiCallLog[]
  aiJobs           AiJob[]

  @@index([userId])
}

model Stack {
  id        String  @id @default(cuid())
  projectId String
  category  String  // frontend | backend | database | deployment
  name      String
  version   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DiscoveryQuestion {
  id               String  @id @default(cuid())
  projectId        String
  round            Int     @default(1)
  order            Int
  question         String
  context          String?
  kind             String  @default("radio") // radio | checkbox
  options          Json    @default("[]")
  required         Boolean @default(true)
  suggestion       String?
  suggestionReason String?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answers DiscoveryAnswer[]

  @@index([projectId])
}

model DiscoveryAnswer {
  id         String   @id @default(cuid())
  questionId String
  answer     String   @default("")
  value      Json?
  createdAt  DateTime @default(now())

  question DiscoveryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Prd {
  id          String   @id @default(cuid())
  projectId   String   @unique
  // Konten PRD disimpan sebagai JSON fleksibel: { overview, goals, features, techRequirements, ... }
  content     Json
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RoadmapPhase {
  id        String  @id @default(cuid())
  projectId String
  order     Int
  title     String
  description String?
  layer     String  // DATABASE | BACKEND | FRONTEND | INTEGRATION

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features  RoadmapFeature[]

  @@index([projectId])
}

model RoadmapFeature {
  id          String  @id @default(cuid())
  phaseId     String
  title       String
  description String?

  phase        RoadmapPhase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  dependencies RoadmapDependency[]  @relation("FeatureDepsFrom")
  dependedOnBy RoadmapDependency[]  @relation("FeatureDepsTo")
  tasks        Task[]

  @@index([phaseId])
}

model RoadmapDependency {
  id           String @id @default(cuid())
  featureId    String
  dependsOnId  String

  feature   RoadmapFeature @relation("FeatureDepsFrom", fields: [featureId], references: [id], onDelete: Cascade)
  dependsOn RoadmapFeature @relation("FeatureDepsTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@index([featureId])
  @@index([dependsOnId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  featureId   String?
  title       String
  description String?
  layer       String   // DATABASE | BACKEND | FRONTEND | INTEGRATION
  status      String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE | BLOCKED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  order       Int      @default(0)
  // aiContext: { files_to_create: string[], files_to_modify: string[], forbidden: string[] }
  aiContext     Json     @default("{}")
  apiContracts  Json     @default("[]")
  outputSummary String?
  acceptanceCriteria Json @default("[]")
  blockedReason String?
  cycleId     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature      RoadmapFeature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  cycle        ProjectCycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  dependsOn    TaskDependency[] @relation("TaskDepsFrom")
  dependencies TaskDependency[] @relation("TaskDepsTo")

  @@index([projectId])
  @@index([featureId])
  @@index([status])
  @@index([cycleId])
}

model ProjectCycle {
  id        String   @id @default(cuid())
  projectId String
  number    Int      // 1..n
  title     String
  request   String
  status    String   @default("DRAFT") // DRAFT | OPEN | DONE
  type      String   @default("MIXED") // FEATURE | BUGFIX | REFACTOR | MIXED
  size      String   @default("MEDIUM") // SMALL | MEDIUM | LARGE
  impact    Json     @default("{}")
  clarify   Json     @default("[]")
  prdDelta  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@index([projectId, number])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task      Task @relation("TaskDepsFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDepsTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dependsOnId])
}

// ============================================================
// Agent (CLI) — Universal PAT with multi-project scope
// ============================================================

model AgentToken {
  id          String            @id @default(cuid())
  userId      String
  name        String
  tokenHash   String            @unique // sha256(token)
  lastUsedAt  DateTime?
  isRevoked   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentTokenScopes AgentTokenScope[]
  sessions     AgentSession[]

  @@index([userId])
}

model AgentTokenScope {
  id        String   @id @default(cuid())
  tokenId   String
  projectId String

  token AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tokenId, projectId]) // ← prevent duplicate scoping
  @@index([projectId])
}

model AgentSession {
  id        String   @id @default(cuid())
  tokenId   String
  taskId    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?

  token AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
}

model Checkpoint {
  id        String   @id @default(cuid())
  projectId String
  type      String   // LAYER_TRANSITION | PRD_APPROVAL | ROADMAP_APPROVAL | APPS_READY_FOR_USE
  layer     String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message   String?
  metadata  Json     @default("{}")
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ============================================================
// Chat Flow — sesi chat sebelum project dibuat
// ============================================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("active") // "active" | "finalized" | "abandoned"
  summary   String?  // ringkasan ide hasil chat (untuk nama project & konteks interview)
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  kind      String      @default("text") // "text" | "form" | "done"
  content   String      // teks pesan; jawaban form diserialkan jadi teks
  payload   Json?       // payload terstruktur untuk kind="form"/"done"
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ============================================================
// Tree Diagram — hierarki App -> Fitur -> Sub-fitur -> Task -> Sub-task
// ============================================================

model TreeNode {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    TreeNode?  @relation("TreeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  TreeNode[] @relation("TreeHierarchy")
  label          String
  kind           String     // "app" | "feature" | "subfeature" | "task" | "subtask"
  requirementIds String[]   @default([])
  order          Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([projectId, parentId])
}

// ============================================================
// Observability — Riwayat pemanggilan AI, token usage, dan latensi (Bab 39)
// ============================================================

// Status job AI async (fire-and-forget + polling frontend).
model AiJob {
  id         String    @id @default(cuid())
  projectId  String
  type       String    // tasks_generate | cycle_generate | roadmap_generate | survey_round | survey_summary | tree_generate | techstack_recommend | chat_finalize
  status     String    @default("running") // running | done | failed
  error      String?
  result     Json?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, status])
}

model AiCallLog {
  id            String   @id @default(cuid())
  projectId     String?
  agentName     String   // e.g. "generateTasks", "generatePRD", "generateRoadmap", "generateSurveyRound", dsb.
  model         String   // e.g. "ai-builder"
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  latencyMs     Int      @default(0)
  retryCount    Int      @default(0)
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())

  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agentName])
  @@index([createdAt])
}

// ============================================================
// SaaS Monetisasi & Billing (Midtrans)
// ============================================================

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("free") // "free" | "starter" | "pro"
  quotaUsed Int       @default(0)
  quotaMax  Int       @default(1)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  midtransId    String?   @unique
  amount        Int
  plan          String
  status        String    @default("pending") // pending | success | failed | expired
  paymentType   String?
  transactionAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([midtransId])
}

