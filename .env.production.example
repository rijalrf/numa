# ==============================================================================
# Numa - Konfigurasi Environment Produksi (.env)
# Salin file ini menjadi .env di direktori aplikasi pada server VPS:
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Konfigurasi Docker Hub (Username Penyedia Image)
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME=username_dockerhub_anda

# ------------------------------------------------------------------------------
# 1. Konfigurasi Database PostgreSQL (Container 'db')
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat
POSTGRES_DB=project_ai_planner

# ------------------------------------------------------------------------------
# 2. Konfigurasi Server API & Better Auth
# ------------------------------------------------------------------------------
PORT=6655
NODE_ENV=production

# Secret kunci enkripsi Better Auth (gunakan string acak minimal 32 karakter)
# Contoh generate: openssl rand -hex 32
BETTER_AUTH_SECRET=ganti_dengan_random_secret_minimal_32_karakter

# URL publik aplikasi yang diarahkan melalui Cloudflare Tunnel / Reverse Proxy
BETTER_AUTH_URL=https://numa.opendv.xyz
FE_URL=https://numa.opendv.xyz

# ------------------------------------------------------------------------------
# 3. Konfigurasi Build Frontend Web
# ------------------------------------------------------------------------------
# Digunakan sebagai build argument VITE_API_URL pada image web
VITE_API_URL=https://numa.opendv.xyz

# ------------------------------------------------------------------------------
# 4. Konfigurasi AI Provider (OpenAI Compatible Gateway)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_API_KEY=sk-ganti_dengan_api_key_anda
OPENAI_MODEL=ai-builder
OPENAI_MODEL_REASONING=ai-builder
OPENAI_MODEL_CHEAP=ai-builder

# ------------------------------------------------------------------------------
# 5. Konfigurasi Google OAuth (Login Pengguna)
# Redirect URI di Google Cloud Console: https://numa.opendv.xyz/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
